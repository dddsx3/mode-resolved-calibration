 # ------------------------------------------------ STEP 5: A4 formal run
 banner "STEP 5 · A4 formal run (29,700 reconstructions)"
 NPROC=$(nproc 2>/dev/null || echo 4)
+CG=$(awk '{printf "%.0f", $1/$2}' /sys/fs/cgroup/cpu.max 2>/dev/null || echo "$NPROC")
 WORKERS="${MRC_WORKERS:-$(( NPROC > 2 ? NPROC - 2 : 1 ))}"
 [ "$WORKERS" -gt 33 ] && WORKERS=33
-echo "  workers: $WORKERS (nproc=$NPROC; hard ceiling 33 cells)"
+# BLAS thread budget: cgroup caps this box (often far below nproc). Letting each
+# worker open one BLAS thread per core oversubscribes by ~workers x cores and
+# makes the run look hung -- measured 16.1 s vs 0.18 s per eigvalsh(1200).
+export OMP_NUM_THREADS="${MRC_OMP_THREADS:-1}"
+export OPENBLAS_NUM_THREADS="$OMP_NUM_THREADS"
+export MKL_NUM_THREADS="$OMP_NUM_THREADS"
+export NUMEXPR_NUM_THREADS="$OMP_NUM_THREADS"
+echo "  workers: $WORKERS (nproc=$NPROC; cgroup cpus=$CG; hard ceiling 33 cells)"
+echo "  blas threads/worker: $OMP_NUM_THREADS (override: MRC_OMP_THREADS=n)"
 cd "$WORK_ROOT"
 "$PYEXE" a4_cloud_driver.py --repo "$NEW_REPO" --workers "$WORKERS" \
     2>&1 | tee "$LOGS/a4_run.log"
