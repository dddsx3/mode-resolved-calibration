+
+
+def _loadavg():
+    try:
+        return open("/proc/loadavg").read().split()[0]
+    except OSError:
+        return "?"
+
+
+def _write_progress(path, **kw):
+    """Publish a worker's live stage (atomic; read by the heartbeat thread)."""
+    try:
+        tmp = path.with_name(path.name + ".tmp")
+        tmp.write_text(json.dumps({"ts": time.time(), **kw}, default=str),
+                       encoding="utf-8")
+        os.replace(tmp, path)
+    except OSError:
+        pass
+
+
+def _read_progress(path):
+    """(stage dict, seconds since last update) or (None, None)."""
+    try:
+        d = json.loads(path.read_text(encoding="utf-8"))
+        return d, max(0.0, time.time() - float(d.get("ts", 0.0)))
+    except (OSError, ValueError, TypeError):
+        return None, None
+
+
+def _heartbeat(futs, submitted, cells_dir, n_todo, live, stop):
+    """One status line every HEARTBEAT_SEC so a stalled run is visible at once."""
+    while not stop.is_set():
+        running = [(c, time.time() - submitted[f])
+                   for f, c in futs.items() if not f.done()]
+        running.sort(key=lambda x: -x[1])
+        parts = []
+        for c, age in running[:5]:
+            d, page = _read_progress(
+                cells_dir / f"cell_{c[0]:02d}_{c[2]}" / "progress.json")
+            tag = f"{c[1]}|{c[2]}"
+            if d is None:
+                parts.append(f"{tag} {age / 60:.0f}min(starting)")
+                continue
+            stale = " STALE!" if page > STALE_SEC else ""
+            parts.append(f"{tag} {age / 60:.0f}min {d.get('stage')}"
+                         f"[r{d.get('regime', '-')} s{d.get('seed', '-')}]"
+                         f" +{page / 60:.0f}min{stale}")
+        print(f"[a4][hb {_hhmmss()}] done {live['done']}/{n_todo} | "
+              f"running {len(running)} | load {_loadavg()} | "
+              + " ; ".join(parts), flush=True)
+        if stop.wait(HEARTBEAT_SEC):
+            break
